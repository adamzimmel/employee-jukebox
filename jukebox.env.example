# Copy to jukebox.env and edit.
PORT=8080
# 127.0.0.1 = only reachable through a tunnel/proxy on this same box (recommended for internet use).
# 0.0.0.0   = reachable from your LAN directly.
HOST=0.0.0.0
# Per IP, per hour. 0 = unlimited for adds.
RATE_LIMIT=30
SKIP_LIMIT=60
REMOVE_LIMIT=20
# Longest song allowed, in minutes. 0 = no limit.
MAX_MINUTES=20
# Most songs kept (about 3.5 MB each).
MAX_SONGS=3000
# Set to 1 ONLY when Cloudflare Tunnel / Caddy / nginx sits in front. Otherwise people could fake their IP.
TRUST_PROXY=0
# Path to yt-dlp, if it isn't on the PATH.
#YTDLP=/usr/local/bin/yt-dlp
